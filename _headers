# Cabeçalhos HTTP para Cloudflare Pages (e Netlify, mesmo formato).
# O app não faz nenhuma requisição externa, então a política pode ser
# fechada: nada de fora carrega, nada sai daqui.

/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), serial=(), bluetooth=(), midi=(), interest-cohort=()
  Content-Security-Policy: default-src 'self' blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# Precisam ser sempre revalidados, senão a atualização não chega.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# O service worker já versiona estes arquivos pelo nome do cache;
# uma hora de cache HTTP evita rede sem atrapalhar atualização.
/css/*
  Cache-Control: public, max-age=3600

/js/*
  Cache-Control: public, max-age=3600

/icons/*
  Cache-Control: public, max-age=604800
