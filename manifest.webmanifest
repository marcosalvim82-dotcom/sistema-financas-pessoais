{
  "name": "Finanças — controle pessoal",
  "short_name": "Finanças",
  "description": "Controle financeiro pessoal com importação automática de extratos e faturas. Todos os dados ficam no seu dispositivo.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "id": "/financas-pessoais",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#F4F4F2",
  "theme_color": "#A87B2E",
  "categories": ["finance", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Importar extrato",
      "short_name": "Importar",
      "url": "./index.html?acao=importar",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Revisar pendências",
      "short_name": "Revisar",
      "url": "./index.html?tela=revisar",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
